# =====================================================================
#  icebergvideo.ru — настройки Apache
# =====================================================================

# ---------------------------------------------------------------------
#  1. Кодировка по умолчанию
# ---------------------------------------------------------------------
AddDefaultCharset UTF-8

# Ретро-версия сайта использует старую кодировку windows-1251
<IfModule mod_mime.c>
    <Files "*.html">
        AddType "text/html; charset=UTF-8" .html
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------------------
#  2. Папка /retro/ — версия для старых браузеров.
#     Открывается по обычному HTTP, БЕЗ перехода на HTTPS,
#     потому что старые браузеры не умеют современное шифрование.
#     Это правило идёт ПЕРВЫМ и останавливает обработку.
# ---------------------------------------------------------------------
RewriteRule ^retro(/.*)?$ - [L]

# ---------------------------------------------------------------------
#  3. Переход на HTTPS для всего остального сайта
# ---------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://icebergvideo.ru/$1 [R=301,L]

# ---------------------------------------------------------------------
#  4. Убираем www — иначе поисковики видят два одинаковых сайта
# ---------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://icebergvideo.ru/$1 [R=301,L]

# ---------------------------------------------------------------------
#  5. Внутренние адреса сайта (/privacy, /terms и другие).
#     Если файла нет на диске — отдаём index.html,
#     дальше страницу собирает сам сайт.
# ---------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/retro
RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------
#  6. Кэширование: файлы сайта обновляются часто, картинки — редко
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
#  7. Сжатие
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
#  8. Страница ошибки
# ---------------------------------------------------------------------
ErrorDocument 404 /index.html
