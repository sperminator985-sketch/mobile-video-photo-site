# =====================================================================
#  Ретро-версия сайта для старых браузеров
#  (Windows 95/98/Me, Netscape Navigator, Internet Explorer 4-5)
# =====================================================================

# ---------------------------------------------------------------------
#  Старая кодировка — так делали сайты в девяностые
# ---------------------------------------------------------------------
AddDefaultCharset windows-1251
AddType "text/html; charset=windows-1251" .html .htm

# ---------------------------------------------------------------------
#  Отключаем принудительный переход на HTTPS.
#  Старые браузеры не умеют современное шифрование и просто
#  не смогут открыть защищённую версию страницы.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteOptions Inherit
    RewriteRule .* - [L]
</IfModule>

# ---------------------------------------------------------------------
#  Никаких современных заголовков безопасности,
#  которые могут сбить с толку старый браузер
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header unset Strict-Transport-Security
    Header unset Content-Security-Policy
    Header unset X-Frame-Options
    Header set X-Robots-Tag "noindex, follow"
</IfModule>

# ---------------------------------------------------------------------
#  Главная страница раздела
# ---------------------------------------------------------------------
DirectoryIndex index.html

# ---------------------------------------------------------------------
#  Своя страница ошибки внутри раздела
# ---------------------------------------------------------------------
ErrorDocument 404 /retro/index.html
